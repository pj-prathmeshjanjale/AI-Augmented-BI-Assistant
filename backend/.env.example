# =============================================================================
# ENTERPRISE AI BI ASSISTANT CONFIGURATION
# Copy this file to .env and configure your environment variables.
# =============================================================================

# LLM Provider Configuration ('groq' or 'openai')
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenAI Provider Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding Model Configuration ('huggingface' or 'openai')
EMBEDDING_PROVIDER=huggingface

# Database Configuration (MySQL business_db)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=business_db
